{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "api/**/*.ts",
    "api/**/*.tsx",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "_project",
    "_backup",
    "backup",
    "backups",
    "scripts",
    "tools",
    "**/*.cjs",
    "**/*.mjs"
  ]
}
